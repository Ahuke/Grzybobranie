# Szablon konfiguracji lokalnej dla projektu "Gdzie na grzyby?"
# Skopiuj ten plik jako .env (plik .env jest ignorowany przez Git)

# Domyślne środowisko danych dla aplikacji Streamlit ("demo" lub "prod")
GRZYBY_DATA_ENV=demo

# Kod TERYT regionu pilotażowego (02 = woj. dolnośląskie)
GRZYBY_REGION_TERYT=02

# Opcjonalne ciasteczko sesyjne do autoryzowanego pobierania raportów z grzyby.pl
# (używane wyłącznie w lokalnych skryptach scrapera, nigdy nie dodawać do repozytorium!)
GRZYBY_SESSION_COOKIE=
